    "diff_eval      = (corr_real_eval - corr_pred_eval).abs().values.mean()\n",
    "print(f'\\n  Diferencia media de correlacion en eval.csv: {diff_eval:.4f}')\n",
    "\n",
    "print('\\n  R2 por target:')\n",
